# The Unity project lives in "Hotel Merge/", so every Unity rule below is written for any depth (no leading "/").
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# ------------------------------------------------------------------ Unity generated folders (GBs, rebuilt by Unity)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emoryCaptures/
**/[Rr]ecordings/
**/.utmp/

# ------------------------------------------------------------------ Builds (APK / AAB, WebGL folder and zip, symbol backups)
**/[Bb]uild/
**/[Bb]uilds/
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.app
*.ipa
*.unitypackage
crashlytics-build.properties

# Scenes Unity saved after a crash (Assets/_Recovery)
**/[Aa]ssets/_Recovery/
**/[Aa]ssets/_Recovery.meta

# ------------------------------------------------------------------ IDE and solution files (regenerated by Unity)
.vs/
.vscode/
.idea/
.consulo/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Packed Addressables and temporary Android assets
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# ------------------------------------------------------------------ Misc
sysinfo.txt
*.log
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ Licensed third-party assets
# The icon packs allow use in a commercial game but forbid sharing the files themselves
# (see Assets/ThirdParty/README.md). If this repository is or becomes PUBLIC, uncomment these lines
# (and remove the files from git history if they were already pushed).
# **/[Aa]ssets/[Tt]hird[Pp]arty/
# **/[Aa]ssets/[Tt]hird[Pp]arty.meta
# **/[Aa]ssets/[Rr]esources/[Aa]rt/[Pp]acks/
# **/[Aa]ssets/[Rr]esources/[Aa]rt/[Pp]acks.meta
